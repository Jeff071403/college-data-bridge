# Django Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Settings (Defaults to SQLite fallback if connection fails)
DB_NAME=mou_dashboard
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Google Drive API Settings
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-drive.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-root-google-drive-folder-id-here

# File Configuration Limits
MAX_UPLOAD_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,png,jpg,jpeg

# Application Log Settings
LOG_LEVEL=INFO
